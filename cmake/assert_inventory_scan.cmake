# Run with -P: ROOT is a tree holding lib/, ALLOW a file of "<path relative to ROOT>|<trimmed assert line>" keys.

foreach(required IN ITEMS ROOT ALLOW)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "assert inventory scan: ${required} is not set")
    endif()
endforeach()

# ';', '[' and ']' would split or fuse CMake list elements, so lines are compared in an encoded form.
string(ASCII 2 enc_semi)
string(ASCII 3 enc_open)
string(ASCII 4 enc_close)

function(encode_text out text)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "${enc_semi}" text "${text}")
    string(REPLACE "[" "${enc_open}" text "${text}")
    string(REPLACE "]" "${enc_close}" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(decode_text out text)
    string(REPLACE "${enc_semi}" ";" text "${text}")
    string(REPLACE "${enc_open}" "[" text "${text}")
    string(REPLACE "${enc_close}" "]" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(assert_keys out path)
    file(READ "${path}" text)
    encode_text(text "\n${text}")
    file(RELATIVE_PATH rel "${ROOT}" "${path}")
    string(REGEX MATCHALL "\n[^\n]*assert\\([^\n]*" lines "${text}")
    set(keys "")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" trimmed)
        if(trimmed MATCHES "^//" OR NOT " ${trimmed}" MATCHES "[^A-Za-z0-9_]assert\\(")
            continue()
        endif()
        list(APPEND keys "${rel}|${trimmed}")
    endforeach()
    set(${out} "${keys}" PARENT_SCOPE)
endfunction()

file(READ "${ALLOW}" allow_text)
encode_text(allow_text "${allow_text}")
string(REGEX MATCHALL "[^\n]+" allow_lines "${allow_text}")
set(allowed "")
foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(NOT line STREQUAL "" AND NOT line MATCHES "^#")
        list(APPEND allowed "${line}")
    endif()
endforeach()

file(GLOB_RECURSE files "${ROOT}/lib/*.h" "${ROOT}/lib/*.hpp")
if(NOT files)
    message(FATAL_ERROR "assert inventory scan: no header under ${ROOT}/lib, so the scan reads nothing")
endif()
list(SORT files)

set(unlisted "")
set(matched 0)
foreach(path IN LISTS files)
    assert_keys(keys "${path}")
    foreach(key IN LISTS keys)
        list(FIND allowed "${key}" at)
        if(at EQUAL -1)
            decode_text(key "${key}")
            string(APPEND unlisted "\n  unlisted assert: ${key}")
        else()
            list(REMOVE_AT allowed ${at})
            math(EXPR matched "${matched} + 1")
        endif()
    endforeach()
endforeach()

set(missing "")
foreach(key IN LISTS allowed)
    decode_text(key "${key}")
    string(APPEND missing "\n  allow-listed assert missing: ${key}")
endforeach()

if(NOT unlisted STREQUAL "" OR NOT missing STREQUAL "")
    message(FATAL_ERROR "assert inventory scan: lib/ and ${ALLOW} disagree; an assert-only public-input guard "
                        "needs a runtime check, and the list must shrink with the code:${unlisted}${missing}")
endif()

list(LENGTH files scanned)
message(STATUS "assert inventory scan: ${scanned} files scanned, ${matched} allow-listed asserts matched")
